DATABASE_URL="mysql://root:password@localhost:3306/robotvoice"

# --- Replicate TTS (MiniMax Speech 2.8 Turbo) ---
# API docs: https://replicate.com/minimax/speech-2.8-turbo
# Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# Model slug. Default is official MiniMax Speech 2.8 Turbo.
# REPLICATE_TTS_MODEL="minimax/speech-2.8-turbo"

# Product voice → MiniMax voice_id mapping.
# Built-in IDs: Deep_Voice_Man, Imposing_Manner, Elegant_Man,
# Casual_Guy, Friendly_Person, Decent_Boy, Lively_Girl,
# Exuberant_Girl, Inspirational_girl, Young_Knight, Abbess, Wise_Woman
# Or paste a custom voice_id from MiniMax voice cloning.
# REPLICATE_VOICE_DEFAULT="Deep_Voice_Man"
# REPLICATE_VOICE_MALE="Deep_Voice_Man"
# REPLICATE_VOICE_FEMALE="Lively_Girl"
# REPLICATE_VOICE_NARRATOR="Elegant_Man"

# Optional synthesis params. Leave blank to use model defaults.
# speed: 0.5–2.0 (default 1)
# REPLICATE_TTS_SPEED="1"
# volume: 0–10 MiniMax TTS gain (not system volume). Default in code is 2.
# REPLICATE_TTS_VOLUME="2"
# pitch: -12 to +12 semitones (default 0)
# REPLICATE_TTS_PITCH="0"
# emotion: auto | neutral | happy | sad | angry | fearful | disgusted | surprised
# REPLICATE_TTS_EMOTION="auto"
# Better English number/date reading; slightly slower
# REPLICATE_TTS_ENGLISH_NORMALIZATION="false"
# sample_rate Hz, e.g. 32000 or 44100
# REPLICATE_TTS_SAMPLE_RATE="32000"
# MP3 bitrate in bps, only used when audio_format=mp3
# REPLICATE_TTS_BITRATE="128000"
# audio_format: mp3 | wav | flac | pcm
# REPLICATE_TTS_AUDIO_FORMAT="mp3"
# channel: mono | stereo
# REPLICATE_TTS_CHANNEL="mono"
# language_boost: None | Automatic | Chinese | English | ...
# REPLICATE_TTS_LANGUAGE_BOOST="None"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="robotvoice-production"

AUTH_SECRET="replace-with-a-random-32-char-secret"
NEXTAUTH_SECRET="replace-with-a-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://robotvoice.org"
# Public inbox shown on Contact and Privacy. Create this mailbox before launch.
# NEXT_PUBLIC_CONTACT_EMAIL="hello@robotvoice.org"
AUTH_DEV_LOGIN="false"

# Testing only. Skip IP daily quota, login, and credits.
# Must be false in production — cost control depends on the IP cap.
DEV_BYPASS_LIMITS="true"

# Traffic validation: hide Pricing / credits / dashboard until this is true.
# SHOW_MONETIZATION="false"

# Free generations per IP per UTC day (default 8).
# VALIDATION_DAILY_IP_LIMIT="8"

CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""

WORKER_URL=""
WORKER_SECRET=""
WORKER_PORT="3001"
